{% layout 'theme' %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap');

  :root {
    --bg: #0a0a0a;
    --gold: #b89a5e;
    --white: #f0ede8;
    --muted: #6b6b6b;
    --text: #c0bdb8;
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'Inter', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }

  .kv {
    background: var(--bg);
    color: var(--white);
    font-family: var(--sans);
    font-weight: 300;
  }

  .kv *, .kv *::before, .kv *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ─── HERO ─── */
  .kv-hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #1a1a1a;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .kv-hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }

  .kv-hero__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 60px 80px 48px;
  }

  @media (max-width: 768px) {
    .kv-hero__left {
      padding: 64px 24px 48px;
      order: 2;
    }
  }

  .kv-hero__right {
    position: relative;
    overflow: hidden;
    min-height: 600px;
  }

  @media (max-width: 768px) {
    .kv-hero__right {
      min-height: 70vw;
      order: 1;
    }
  }

  .kv-hero__right img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s ease;
  }

  .kv-hero__right:hover img {
    transform: scale(1.03);
  }

  .kv-hero__eyebrow {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 28px;
  }

  .kv-hero__title {
    font-family: var(--serif);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .kv-hero__sub {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text);
    max-width: 420px;
    margin-bottom: 16px;
  }

  .kv-hero__note {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 48px;
    opacity: 0.8;
  }

  .kv-btn {
    display: inline-block;
    padding: 16px 40px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    background: transparent;
  }

  .kv-btn:hover {
    background: var(--gold);
    color: var(--bg);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(184,154,94,0.2);
  }

  /* ─── SECTIONS ─── */
  .kv-section {
    padding: 100px 24px;
    max-width: 900px;
    margin: 0 auto;
    border-bottom: 1px solid #1a1a1a;
  }

  .kv-section--full {
    max-width: 100%;
    padding: 100px 0;
    border-bottom: 1px solid #1a1a1a;
  }

  .kv-label {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 40px;
  }

  .kv-title {
    font-family: var(--serif);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    line-height: 1.15;
    margin-bottom: 28px;
  }

  .kv-body {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text);
    max-width: 640px;
  }

  /* ─── TWO COLUMNS ─── */
  .kv-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  @media (max-width: 768px) {
    .kv-cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ─── PECA DUPLA VISUAL ─── */
  .kv-peca {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin-top: 48px;
  }

  @media (max-width: 768px) {
    .kv-peca {
      grid-template-columns: 1fr;
    }
  }

  .kv-peca-img {
    aspect-ratio: 3/4;
    overflow: hidden;
    position: relative;
  }

  .kv-peca-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .kv-peca-img:hover img {
    transform: scale(1.04);
  }

  .kv-peca-img__label {
    position: absolute;
    bottom: 16px;
    left: 16px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    background: rgba(0,0,0,0.4);
    padding: 4px 10px;
    backdrop-filter: blur(4px);
  }

  /* ─── IMAGE ─── */
  .kv-img-wrap {
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
  }

  .kv-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .kv-img-wrap:hover img {
    transform: scale(1.03);
  }

  /* ─── LIST ─── */
  .kv-list {
    list-style: none;
  }

  .kv-list li {
    padding: 20px 0;
    border-bottom: 1px solid #1a1a1a;
    font-size: 15px;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .kv-list li::before {
    content: '—';
    color: var(--gold);
    flex-shrink: 0;
  }

  /* ─── TERMS ─── */
  .kv-terms {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 48px;
  }

  @media (max-width: 768px) {
    .kv-terms {
      grid-template-columns: 1fr;
    }
  }

  .kv-terms-block {
    padding: 40px;
    border: 1px solid #1a1a1a;
    background: #0d0d0d;
  }

  .kv-terms-block__num {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 12px;
    display: block;
  }

  .kv-terms-block__title {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 300;
    color: var(--white);
    margin-bottom: 20px;
  }

  .kv-terms-block ul {
    list-style: none;
  }

  .kv-terms-block ul li {
    font-size: 13px;
    color: #9a9690;
    line-height: 1.7;
    padding: 6px 0;
    border-bottom: 1px solid #141414;
    display: flex;
    gap: 10px;
  }

  .kv-terms-block ul li::before {
    content: '·';
    color: var(--gold);
    flex-shrink: 0;
  }

  .kv-terms-block--highlight {
    border-color: #2a2218;
    background: #0f0d09;
  }

  .kv-terms-block--highlight .kv-terms-block__title {
    color: var(--gold);
  }

  /* ─── GALLERY ─── */
  .kv-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }

  @media (max-width: 600px) {
    .kv-gallery {
      grid-template-columns: 1fr 1fr;
    }
  }

  .kv-gallery-item {
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
  }

  .kv-gallery-item--tall {
    aspect-ratio: 3/4;
  }

  .kv-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .kv-gallery-item:hover img {
    transform: scale(1.05);
  }

  .kv-gallery-item__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    background: rgba(0,0,0,0.45);
    padding: 3px 8px;
    backdrop-filter: blur(4px);
  }

  /* ─── SPLIT VISUAL ─── */
  .kv-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #1a1a1a;
    min-height: 500px;
  }

  @media (max-width: 768px) {
    .kv-split {
      grid-template-columns: 1fr;
    }
  }

  .kv-split__img {
    overflow: hidden;
    position: relative;
  }

  .kv-split__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .kv-split__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 60px;
    background: #050505;
  }

  @media (max-width: 768px) {
    .kv-split__text {
      padding: 60px 24px;
    }
  }

  .kv-split__quote {
    font-family: var(--serif);
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.35;
    color: var(--white);
    margin-bottom: 32px;
  }

  .kv-split__sub {
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 360px;
  }

  /* ─── FORM ─── */
  .kv-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .kv-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .kv-field label {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .kv-field input,
  .kv-field textarea {
    background: #0f0f0f;
    border: 1px solid #2a2a2a;
    color: var(--white);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 300;
    padding: 16px;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }

  .kv-field input:focus,
  .kv-field textarea:focus {
    border-color: var(--gold);
  }

  .kv-field textarea {
    min-height: 140px;
    resize: vertical;
  }

  .kv-form-success {
    padding: 24px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-align: center;
  }

  /* ─── CLOSING ─── */
  .kv-closing {
    padding: 120px 24px;
    text-align: center;
    background: #050505;
    position: relative;
    overflow: hidden;
  }

  .kv-closing__bg {
    position: absolute;
    inset: 0;
    background-image: url('https://cdn.shopify.com/s/files/1/0635/2741/9974/files/KV_001_ORIENTAL_3_00f2df44-b5d3-45bc-96a7-709d6d250b98.jpg?v=1779222983');
    background-size: cover;
    background-position: center;
    opacity: 0.05;
  }

  .kv-closing p {
    font-family: var(--serif);
    font-size: clamp(22px, 3vw, 38px);
    font-weight: 300;
    font-style: italic;
    color: var(--white);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.5;
    position: relative;
    z-index: 1;
  }

  /* ─── FADE IN ─── */
  .kv-fade {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .kv-fade.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── HEADER/FOOTER OVERRIDE ─── */
  #shopify-section-header,
  #shopify-section-footer,
  header,
  footer {
    display: none !important;
  }
{% endstyle %}

