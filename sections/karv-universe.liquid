<section class="karv-universe karv-shell">
  <div class="karv-universe__copy"><p class="karv-section-label"><span>{{ section.settings.eyebrow }}</span></p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.text }}</div>{% if section.settings.link != blank %}<a class="karv-text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }} →</a>{% endif %}</div>
  <div class="karv-universe__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '800,1200,1800', sizes: '(min-width: 900px) 70vw, 100vw' }}{% endif %}</div>
</section>
{% stylesheet %}.karv-universe{display:grid;grid-template-columns:280px 1fr;gap:28px;padding-top:22px;padding-bottom:42px}.karv-universe__copy{padding:30px 0}.karv-universe h2{font-size:clamp(1.7rem,2.5vw,2.7rem);line-height:1.05;font-weight:500;text-transform:uppercase;margin:20px 0}.karv-universe__copy>div{font-size:.86rem;color:var(--karv-muted);margin-bottom:28px}.karv-universe__media{min-height:360px;border-radius:6px;overflow:hidden;background:#e5e0d8}.karv-universe__media img{width:100%;height:100%;object-fit:cover}@media(max-width:800px){.karv-universe{grid-template-columns:1fr}.karv-universe__media{min-height:280px}}{% endstylesheet %}
{% schema %}{"name":"KARV — Universo","settings":[{"type":"text","id":"eyebrow","label":"Linha superior","default":"UNIVERSO KARV"},{"type":"text","id":"heading","label":"Título","default":"MAIS QUE POLTRONAS. SUPORTES PARA IDEIAS, ATITUDES E CULTURA."},{"type":"richtext","id":"text","label":"Texto","default":"<p>A KARV transforma design em expressão. Cada edição carrega referências, histórias e intenções que ganham vida nas formas e nos materiais.</p>"},{"type":"image_picker","id":"image","label":"Imagem"},{"type":"text","id":"link_label","label":"CTA","default":"CONHEÇA NOSSO UNIVERSO"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"KARV — Universo"}]}{% endschema %}