<section class="karv-editions karv-shell">
  <div class="karv-editions__head">
    <div>
      <p class="karv-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% if section.settings.text != blank %}<div class="karv-editions__intro">{{ section.settings.text }}</div>{% endif %}
  </div>

  <div class="karv-editions__grid">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      <article class="karv-edition" {{ block.shopify_attributes }}>
        <a href="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif collection != blank %}{{ collection.url }}{% else %}#{% endif %}">
          <div class="karv-edition__image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(min-width: 900px) 50vw, 100vw' }}
            {% elsif collection != blank and collection.featured_image != blank %}
              {{ collection.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(min-width: 900px) 50vw, 100vw' }}
            {% endif %}
          </div>
          <div class="karv-edition__meta">
            <div>
              {% if block.settings.kicker != blank %}<p class="karv-eyebrow">{{ block.settings.kicker }}</p>{% endif %}
              <h3>{% if block.settings.title != blank %}{{ block.settings.title }}{% elsif collection != blank %}{{ collection.title }}{% else %}Edição KARV{% endif %}</h3>
            </div>
            <span aria-hidden="true">↗</span>
          </div>
        </a>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
.karv-editions{padding-top:96px;padding-bottom:110px}.karv-editions__head{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end;margin-bottom:44px}.karv-editions h2{font-size:clamp(2.4rem,5vw,5.5rem);line-height:.95;letter-spacing:-.045em;font-weight:500;margin:12px 0 0}.karv-editions__intro{max-width:520px;color:var(--karv-muted);font-size:1.05rem}.karv-editions__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.karv-edition__image{aspect-ratio:4/5;background:#ddd;overflow:hidden;border-radius:var(--karv-radius)}.karv-edition__image img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1)}.karv-edition a:hover img{transform:scale(1.025)}.karv-edition__meta{display:flex;justify-content:space-between;gap:20px;padding:18px 2px 8px;border-bottom:1px solid var(--karv-line)}.karv-edition h3{font-size:clamp(1.5rem,2.2vw,2.4rem);font-weight:500;letter-spacing:-.025em;margin:6px 0 0}@media(max-width:760px){.karv-editions{padding-top:64px;padding-bottom:72px}.karv-editions__head{grid-template-columns:1fr;gap:18px}.karv-editions__grid{grid-template-columns:1fr}.karv-edition__image{aspect-ratio:4/5}}
{% endstylesheet %}

{% schema %}
{
  "name":"KARV — Edições",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Linha superior","default":"Edições KARV"},
    {"type":"text","id":"heading","label":"Título","default":"Cada peça, um universo."},
    {"type":"richtext","id":"text","label":"Introdução","default":"<p>Explore coleções e edições autorais. Cada experiência pode aprofundar sua narrativa no KARV Core.</p>"}
  ],
  "blocks":[
    {
      "type":"edition",
      "name":"Edição",
      "settings":[
        {"type":"collection","id":"collection","label":"Coleção Shopify"},
        {"type":"image_picker","id":"image","label":"Imagem editorial opcional"},
        {"type":"text","id":"kicker","label":"Identificador","default":"Edição autoral"},
        {"type":"text","id":"title","label":"Título opcional"},
        {"type":"url","id":"link","label":"Link opcional (LP/KARV Core ou coleção)"}
      ]
    }
  ],
  "max_blocks":8,
  "presets":[{"name":"KARV — Edições","blocks":[{"type":"edition"},{"type":"edition"}]}]
}
{% endschema %}
