{% if product.metafields.custom.spline_url.value != blank %}
  <script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.97/build/spline-viewer.js"></script>
  <div style="margin-top: 24px; padding: 0 16px;">
    <p style="
      font-size: 30px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      opacity: 0.5;
      margin-bottom: 12px;
    ">Explore em 3D</p>
    <spline-viewer
      url="{{ product.metafields.custom.spline_url.value }}"
      loading="lazy"
      style="width: 100%; height: 1000px; display: block;">
    </spline-viewer>
  </div>
{% endif %}

{% schema %}
{
  "name": "Spline 3D Viewer",
  "limit": 1
}
{% endschema %}
